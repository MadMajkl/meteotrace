<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget 4 × 2 a větší (R29) — výchozí velikost, na kterou jde stohovat
  se systémovým počasím.

  ⚠️ Všechny texty jsou bílé se stínem: obloha se mění podle počasí a text
  musí být čitelný na každé (kontrast hlídá `selftest-widget.mjs`).
  ⚠️ `@android:id/background` na kořeni: Android 12+ podle něj dělá
  animaci otevření appky z widgetu a ořez rohů.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_pozadi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- Místo a čas načtení. 🚨 Místo musí být vidět vždycky (R25):
             widget jde pro POSLEDNÍ známou polohu, ne pro tu, kde je telefon. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_misto"
                style="@style/WidgetText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/w_cas"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:alpha="0.8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Hlavní řádek: ikona, velké číslo a vpravo slovo s podrobnostmi. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_ikona"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/w_teplota"
                style="@style/WidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:textSize="52sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_popis"
                    style="@style/WidgetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:maxLines="2"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/w_pocitove"
                    style="@style/WidgetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.88"
                    android:singleLine="true"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/w_maxmin"
                    style="@style/WidgetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.88"
                    android:singleLine="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Kdy začne / přestane pršet. Vždycky jedna z vět — i „sucho"
             je odpověď (viz `vetaODesti()` ve `web/lib/widget.js`). -->
        <TextView
            android:id="@+id/w_veta"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pilulka"
            android:ellipsize="end"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:singleLine="true"
            android:textSize="12sp" />

        <!-- Hodiny dopředu. Buňky přidává obal (`widget_pocasi_hodina`). -->
        <LinearLayout
            android:id="@+id/w_hodiny"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
