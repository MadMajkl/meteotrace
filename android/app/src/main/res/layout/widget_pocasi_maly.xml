<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2 × 2 (R29): čtverec — číslo a ikona nahoře, pod nimi slovo a déšť. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_pozadi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/w_misto"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_teplota"
                style="@style/WidgetText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:textSize="46sp" />

            <!-- ⚠️ Ikona a max/min nad sebou vpravo od čísla: na vlastní řádek
                 už max/min nezbylo místo a věta o dešti pak lezla přes něj. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_ikona"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/w_maxmin"
                    style="@style/WidgetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.88"
                    android:singleLine="true"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/w_popis"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_veta"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:alpha="0.9"
            android:ellipsize="end"
            android:gravity="bottom"
            android:maxLines="2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_cas"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.75"
            android:singleLine="true"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
