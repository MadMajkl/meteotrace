<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Appka si tahá data z našeho serveru přes nativní potrubí (R13). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Poloha: appka ji potřebuje na tlačítko „kde jsem". Ptá se o ni web
      (`navigator.geolocation`), ale ve WebView musí povolit i ANDROID —
      bez těchhle dvou řádků se systémový dialog nikdy neukáže a poloha
      mlčky nefunguje. Hrubá stačí; appka ukazuje počasí, ne navigaci.
      Obojí je nepovinné: appka bez polohy funguje, jen se místo hledá ručně.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Upozornění na výstrahy. Od Androidu 13 se o povolení MUSÍ požádat za
      běhu — bez něj `notify()` tiše selže a appka by tvrdila „hlídám",
      zatímco by se nic neukázalo.
      ⚠️ Nepovinné: kdo upozornění nechce, appku používá dál beze změny.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Kontrola výstrah má přežít restart telefonu. WorkManager si periodickou
      práci obnoví sám, ale jen když k tomu má tohle povolení — jinak by
      hlídání po restartu tiše skončilo a nikdo by si toho nevšiml, dokud by
      nepřišla bouřka.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeteoTrace"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Budík ranní a večerní zprávy (R25).
          ⚠️ `exported="false"`: budí ho jen náš vlastní `PendingIntent`.
          Otevřený příjemce by šel spustit odkudkoli a zvonil by na povel
          cizí appky.
        -->
        <receiver android:name=".BudikZprav" android:exported="false" />

        <!--
          Po restartu telefonu se budíky ztrácejí — Android je nedrží.
          🚨 Bez tohohle by ranní zpráva po restartu tiše přestala chodit
          a od vady by se to nedalo odlišit. (`WorkManager` u výstrah si
          svou práci obnoví sám, budík ne.)
        -->
        <receiver android:name=".PoRestartu" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Widget na ploše (R29).
          ⚠️ `exported="false"` jako u Gulpky: aktualizaci doručuje systém,
          který na neexportovaného příjemce dosáhne; cizí appka ne.
          Obnovu po restartu telefonu si WorkManager obnoví sám (viz výše).
        -->
        <receiver android:name=".PocasiWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pocasi_info" />
        </receiver>
    </application>
</manifest>
